# ---------- Intervals.icu ----------
# API-key: Intervals.icu > Settings > Developer Settings. Blijft alleen op de server.
INTERVALS_API_KEY=jouw_api_key
# "0" = de atleet van de API-key, of je eigen ID (bijv. i123456)
INTERVALS_ATHLETE_ID=0
# Cacheduur van dashboard-data in seconden
CACHE_TTL_SECONDS=300

# ---------- Server ----------
PORT=4000
# 127.0.0.1 = alleen bereikbaar vanaf deze computer. Pas bij online hosten 0.0.0.0.
HOST=127.0.0.1
# Achter een reverse proxy (hosting): aantal proxy-hops, bijv. 1. Leeg = uit.
TRUST_PROXY=
# Productie: map met de gebouwde frontend (relatief aan backend/)
STATIC_DIR=

# ---------- Coachoverzicht ----------
# auto = alle atleten waarvoor je write-toegang hebt (icu_permission WRITE in GET /athletes).
# Of een vaste, komma-gescheiden lijst athlete-ID's, bijv. i49046,i12345
COACH_ATHLETE_IDS=auto
# Cache van het coachoverzicht in seconden (standaard 1 uur)
COACH_CACHE_TTL_SECONDS=3600

# ---------- Toegang ----------
# Login voor jezelf (hele dashboard). "off" mag alleen als HOST=127.0.0.1.
OWNER_AUTH=on
# bcrypt-hashes, maken met: npm run hash-password  (zet ze tussen enkele aanhalingstekens)
OWNER_PASSWORD_HASH=''
# Wachtwoord voor derden: alleen /share/ en het coachoverzicht. Leeg = delen staat uit.
SHARE_PASSWORD_HASH=''
# Geheim voor het ondertekenen van sessies, min. 32 tekens: npm run gen-secret
SESSION_SECRET=
# Ophogen (2, 3, ...) trekt alle bestaande sessies in
SESSION_VERSION=1
# Geldigheid van een sessie in uren
SESSION_TTL_HOURS=12
# Rate limiting op de login: max. pogingen per venster
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
