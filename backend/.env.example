# Intervals.icu API-key: Intervals.icu > Settings > Developer Settings
INTERVALS_API_KEY=jouw_api_key
# Athlete-ID, bijv. i123456 (te zien in de URL van je profiel). "0" = de atleet van de API-key.
INTERVALS_ATHLETE_ID=0
# Poort van de backend
PORT=4000
# Toegestane origin(s) voor CORS, komma-gescheiden
CORS_ORIGIN=http://localhost:5173
# Cacheduur van API-antwoorden in seconden
CACHE_TTL_SECONDS=300
